# ──────────────────────────────────────────────
# .env.example – copie para .env e preencha
# NUNCA commite o .env real no repositório!
# ──────────────────────────────────────────────

# ── Banco de dados (Docker Compose local) ─────
DB_USER=sa
DB_PASSWORD=SuaSenhaAqui

# ── Azure Container Registry ──────────────────
ACR_NAME=meuacr
ACR_LOGIN_SERVER=meuacr.azurecr.io

# ── Azure Kubernetes Service ──────────────────
AKS_RESOURCE_GROUP=rg-store
AKS_CLUSTER_NAME=aks-store

# ── Azure DevOps Service Connections ──────────
# Configure no portal: Project Settings > Service Connections
ACR_SERVICE_CONNECTION=acr-service-connection
AZURE_SERVICE_CONNECTION=azure-service-connection

# ── Spring Boot ────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/storedb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=SuaSenhaAqui
