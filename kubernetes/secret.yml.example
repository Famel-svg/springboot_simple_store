# ──────────────────────────────────────────────────
# ATENÇÃO: Este arquivo é apenas um EXEMPLO.
# NUNCA commite secrets reais no repositório.
# Crie os secrets diretamente no cluster via:
#
#   kubectl create secret generic postgres-secret \
#     --from-literal=POSTGRES_USER=<usuario> \
#     --from-literal=POSTGRES_PASSWORD=<senha> \
#     -n staging
#
#   kubectl create secret generic app-secret \
#     --from-literal=SPRING_DATASOURCE_USERNAME=<usuario> \
#     --from-literal=SPRING_DATASOURCE_PASSWORD=<senha> \
#     -n staging
#
# Repita para o namespace "production".
# ──────────────────────────────────────────────────

---
# Exemplo de estrutura (valores em base64)
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: staging   # trocar para production quando aplicar lá
type: Opaque
data:
  POSTGRES_USER: <base64_do_usuario>       # echo -n 'usuario' | base64
  POSTGRES_PASSWORD: <base64_da_senha>     # echo -n 'senha' | base64

---
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: staging
type: Opaque
data:
  SPRING_DATASOURCE_USERNAME: <base64_do_usuario>
  SPRING_DATASOURCE_PASSWORD: <base64_da_senha>
